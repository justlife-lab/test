# =============================================================================
# Justlife Teleconsultation — SECRET environment variables
# Set these in Vercel → Project → Settings → Environment Variables.
# For local development copy this file to .env.local. NEVER commit real values.
#
# Non-secret settings (Google Sheet link, Google client ID, allowed domain,
# AUTH_MODE…) live in config/config.js instead.
# =============================================================================

# --- App URL (links in emails + Google OAuth callback) -------------------------
# Google redirect URI = $NEXTAUTH_URL/api/auth/callback/google
NEXTAUTH_URL=https://your-app.vercel.app
APP_URL=https://your-app.vercel.app

# --- Sign-in -------------------------------------------------------------------
# Session encryption key. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Google Cloud → Credentials → your OAuth "Web application" client → Client secret.
# (The client ID is in config/config.js ▸ GOOGLE_CLIENT_ID.)
GOOGLE_CLIENT_SECRET=
# Only when config AUTH_MODE = 'test': shared password for @justlife.com test logins (min 8 chars).
TEST_LOGIN_PASSWORD=

# --- Google Sheet connection (pick the one matching config SHEETS_CONNECTION) ---
# 'service-account': paste the WHOLE JSON key file of the service account
# (Google Cloud → IAM → Service accounts → Keys → Add key → JSON), on one line or as-is.
# Then share the spreadsheet with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# 'apps-script' and/or FILE_STORAGE 'drive': same value as the APP_SECRET script property (≥ 24 chars).
APPS_SCRIPT_SECRET=
# Optional: use a different sheet than config/config.js (e.g. a test sheet for Preview deployments).
GOOGLE_SHEET_URL=

# --- Email ---------------------------------------------------------------------
# resend | smtp | console (console only prints to the server log)
EMAIL_PROVIDER=resend
EMAIL_FROM="Justlife Healthcare <teleconsult@justlife.com>"
EMAIL_REPLY_TO=healthcare@justlife.com
RESEND_API_KEY=
# smtps://user:password@smtp.example.com:465
SMTP_URL=
# Secret for the delivery-status webhook: /api/webhooks/email?secret=...
EMAIL_WEBHOOK_SECRET=

# --- Scheduled jobs & integrations ----------------------------------------------
# Vercel Cron / Apps Script send "Authorization: Bearer $CRON_SECRET" to /api/cron/reminders
CRON_SECRET=
# Integrations / BI: header "X-API-Key: $INTEGRATION_API_KEY" (min 24 chars)
INTEGRATION_API_KEY=
# Optional: every booking event is POSTed here as signed JSON (WhatsApp/SMS/CRM bridge)
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
# Optional extra admin allow-list (comma-separated, within @justlife.com). Also in config ADMIN_EMAILS.
ADMIN_EMAILS=

# --- File storage = 's3' only (config FILE_STORAGE) ------------------------------
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Local development without Google (never in production) ---------------------
# SHEETS_DRIVER=memory
# SHEETS_MEMORY_FILE=.data/sheet.json
DEMO_DOCTOR_PASSWORD=Demo-Doctor-2026
